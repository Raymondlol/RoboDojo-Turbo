# RoboDojo-Turbo recommended settings: Pi_05 policy, joint actions. Use with `scripts/rdturbo_eval.sh --preset speedup`
# or `set -a; source robodojo_turbo/presets/speedup.env; set +a`. See docs/switches.md for what each switch does and its evidence.
# Harness
RDTURBO_OBS_EVERY_STEP=0          # upload observations only at chunk starts (Pi_05 reads nothing else)
RDTURBO_VIDEO_EVERY=1             # still render and record every step
RDTURBO_FAST=1                    # lossless copy/recompute removal
RDTURBO_FFMPEG_THREADS=2          # x264 threads per video stream, as in the measured runs (upstream default: 1.5x visible cores)
RDTURBO_VIDEO_CAMS=cam_head       # record only the head camera (fewer video files; videos are not scored)
RDTURBO_STRICT=1                  # exit non-zero if a batch was skipped by RoboDojo's generic exception handler
# Speedup switches
RDTURBO_REVOKE_LISTENERS=1
RDTURBO_RGB3=1
RDTURBO_VIDEO_ONLY_OBS=1
RDTURBO_USD_LAST=1                # RDTURBO_USD_LAST_MODE=auto: 'last' on fluid/garment scenes, 'flush' otherwise
RDTURBO_CTRL_CACHE=1
RDTURBO_GC=freeze
RDTURBO_PARENT_CACHE=1
RDTURBO_VIDEO_MV=1
RDTURBO_PCI_COPY=1
RDTURBO_BATCH_TENSOR=1
# Ops
RDTURBO_NO_PLANNER=1              # joint actions only
RDTURBO_OFFLINE_ASSETS=1          # use the NVIDIA asset mirror if present (scripts/mirror_nv_assets.sh), else stay online
RDTURBO_OVERLAP_START=1           # launcher: start clients while the policy server loads
JAX_COMPILATION_CACHE_DIR=${HOME}/.cache/robodojo_turbo/jax
XLA_PYTHON_CLIENT_PREALLOCATE=false
XLA_PYTHON_CLIENT_ALLOCATOR=platform
