# Check modes, on top of the speedup preset: `rdturbo_eval.sh --preset speedup,verify` (or source AFTER speedup.env).
# CTRL_CACHE, PARENT_CACHE, PCI_COPY and BATCH_TENSOR compute both paths and continue with the upstream result;
# VIDEO_ONLY_OBS (incl. RGB3) compares both and continues with the fast path's frames; USD_LAST=check keeps the fast
# path and compares USD with PhysX after every action. Counters (cumulative over the process) are printed as
# "[robodojo-turbo] batch-stats ..." after every batch. Slower; not for timing.
RDTURBO_VIDEO_ONLY_OBS=check
RDTURBO_USD_LAST=check
RDTURBO_CTRL_CACHE=check
RDTURBO_PARENT_CACHE=check
RDTURBO_PCI_COPY=check
RDTURBO_BATCH_TENSOR=check
RDTURBO_GC=freeze,log
