# Harness only: chunk-start upload, lossless fast path, head-camera video, x264 -threads 2; no speedup switches.
# Corresponds to the baseline arm "a125" of docs/benchmark.md, which also used a server-side CRN patch not included here.
RDTURBO_OBS_EVERY_STEP=0
RDTURBO_VIDEO_EVERY=1
RDTURBO_FAST=1
RDTURBO_FFMPEG_THREADS=2          # x264 threads per video stream; the measured runs used 2 (upstream default: 1.5x visible cores)
RDTURBO_VIDEO_CAMS=cam_head
RDTURBO_STRICT=1
